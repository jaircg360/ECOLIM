<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F7">

    <!-- BARRA SUPERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#168544">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nueva recolección"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp" />

    </LinearLayout>


    <!-- CONTENIDO -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- FECHA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtFecha"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:hint="Seleccione la fecha"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:padding="14dp"
                android:background="#FFFFFF" />


            <!-- HORA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Hora"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtHora"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:hint="Seleccione la hora"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:padding="14dp"
                android:background="#FFFFFF" />


            <!-- OBSERVACIÓN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Observación (opcional)"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtObservacion"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:hint="Ej. Recolección en turno mañana"
                android:padding="14dp"
                android:background="#FFFFFF" />


            <!-- TITULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Agregar residuos"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="17sp" />


            <!-- TIPO DE RESIDUO -->

            <Spinner
                android:id="@+id/spinnerResiduo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF" />


            <!-- CANTIDAD -->

            <EditText
                android:id="@+id/edtCantidad"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:hint="Cantidad en kg"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:background="#FFFFFF" />


            <!-- BOTÓN AGREGAR -->

            <Button
                android:id="@+id/btnAgregarResiduo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="+  Agregar tipo de residuo"
                android:textColor="#168544"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF" />


            <!-- LISTA -->

            <TextView
                android:id="@+id/txtListaResiduos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="#333333"
                android:textSize="15sp" />


            <!-- SEPARADOR -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="#DDDDDD" />


            <!-- TOTAL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total:"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kg"
                    android:textColor="#168544"
                    android:textStyle="bold"
                    android:textSize="18sp" />

            </LinearLayout>


            <!-- GUARDAR -->

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:text="Guardar recolección"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#168544" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>