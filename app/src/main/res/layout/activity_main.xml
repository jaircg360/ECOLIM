<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTENEDOR PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F7F8F7">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#168544">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="🔔"
            android:textSize="22sp" />

    </LinearLayout>


    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- TARJETA USUARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="28sp"
                    android:background="#E8F5E9" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/txtNombreUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hola, Juan Pérez"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Empleado"
                        android:textColor="#777777"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- TITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Resumen general"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="17sp" />


            <!-- PRIMERA FILA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- RECOLECCIONES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="23sp"
                        android:background="#E3F2FD" />

                    <TextView
                        android:id="@+id/txtRecolecciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="0"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recolecciones"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- TOTAL KG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:background="#FFFFFF"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="♻️"
                        android:textSize="23sp"
                        android:background="#E8F5E9" />

                    <TextView
                        android:id="@+id/txtTotalKg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="0 kg"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total residuos"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- SEGUNDA FILA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- TIPOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="🌱"
                        android:textSize="23sp"
                        android:background="#E8F5E9" />

                    <TextView
                        android:id="@+id/txtTipos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="7"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipos de residuos"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- REPORTES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:background="#FFFFFF"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="📊"
                        android:textSize="23sp"
                        android:background="#FFF3E0" />

                    <TextView
                        android:id="@+id/txtReportes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="0"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reportes"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ACCESOS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Accesos rápidos"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="17sp" />


            <!-- NUEVA RECOLECCION -->
            <LinearLayout
                android:id="@+id/btnNuevaRecoleccion"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nueva recolección"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"
                    android:textColor="#777777" />

            </LinearLayout>


            <!-- HISTORIAL -->
            <LinearLayout
                android:id="@+id/btnHistorial"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🕘"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Historial de recolecciones"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"
                    android:textColor="#777777" />

            </LinearLayout>


            <!-- TIPOS DE RESIDUOS -->
            <LinearLayout
                android:id="@+id/btnTiposResiduos"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="♻️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tipos de residuos"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"
                    android:textColor="#777777" />

            </LinearLayout>


            <!-- REPORTES -->
            <LinearLayout
                android:id="@+id/btnReportes"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Generar reporte"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="25sp"
                    android:textColor="#777777" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nInicio"
            android:textColor="#168544"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/navRecolecciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🚚\nRecolecciones"
            android:textColor="#777777"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navNuevaRecoleccion"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/circle_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navReportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📊\nReportes"
            android:textColor="#777777"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nPerfil"
            android:textColor="#777777"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
    <!-- MENÚ LATERAL -->
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="20dp"
            android:background="#168544">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♻️"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EcoLIM"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de residuos"
                android:textColor="#E8F5E9"
                android:textSize="13sp" />

        </LinearLayout>
        <!-- INICIO -->
        <TextView
            android:id="@+id/menuInicio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="🏠    Inicio"
            android:textColor="#168544"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- NUEVA RECOLECCIÓN -->
        <TextView
            android:id="@+id/menuNuevaRecoleccion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="📄    Nueva recolección"
            android:textColor="#333333"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- HISTORIAL -->
        <TextView
            android:id="@+id/menuHistorial"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="🕘    Historial"
            android:textColor="#333333"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- REPORTES -->
        <TextView
            android:id="@+id/menuReportes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="📊    Reportes"
            android:textColor="#333333"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- TIPOS -->
        <TextView
            android:id="@+id/menuTipos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="♻️    Tipos de residuos"
            android:textColor="#333333"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- PERFIL -->
        <TextView
            android:id="@+id/menuPerfil"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="👤    Perfil"
            android:textColor="#333333"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>