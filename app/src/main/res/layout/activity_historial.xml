<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F7">

    <!-- BARRA SUPERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#168544">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recolecciones"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⚱"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </LinearLayout>


    <!-- FILTROS -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/filtroTodas"
                android:layout_width="80dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="Todas"
                android:textColor="#168544"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filtroHoy"
                android:layout_width="80dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="Hoy"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filtroSemana"
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="Esta semana"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/filtroMes"
                android:layout_width="100dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="Este mes"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- LISTA DE RECOLECCIONES -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorRecolecciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />

    </ScrollView>


    <!-- BARRA INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nInicio"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🚚\nRecolecciones"
            android:textColor="#168544"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navAgregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:background="#168544" />

        <TextView
            android:id="@+id/navReportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📊\nReportes"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nPerfil"
            android:textColor="#777777"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>