<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F6">

    <!-- Barra superior -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#087F3F">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="36sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Generar reporte"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="8dp" />

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- Fecha inicio -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha inicio"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtFechaInicio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background"
                android:hint="dd/MM/yyyy"
                android:padding="14dp"
                android:focusable="false"
                android:clickable="true"
                android:textSize="14sp" />


            <!-- Fecha fin -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha fin"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtFechaFin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background"
                android:hint="dd/MM/yyyy"
                android:padding="14dp"
                android:focusable="false"
                android:clickable="true"
                android:textSize="14sp" />


            <!-- Tipo de residuo -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de residuo"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerTipoResiduo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background" />


            <!-- Volumen -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volumen (kg)"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerVolumen"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background" />


            <!-- Botón -->

            <Button
                android:id="@+id/btnGenerarReporte"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Generar reporte"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:backgroundTint="#087F3F" />


            <!-- Reportes recientes -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reportes recientes"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Todos los residuos"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reporte general de recolecciones"
                    android:textSize="13sp"
                    android:textColor="#777777"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>