<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#087F3F">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="@android:color/white"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REPORTE DE RESIDUOS"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PERIODO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Periodo"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="15dp" />


            <!-- TIPO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de residuo"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="15dp" />


            <!-- VOLUMEN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volumen"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtVolumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="20dp" />


            <!-- TOTAL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL RECOLECTADO"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtTotalKg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 kg"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="#087F3F"
                android:paddingBottom="25dp" />


            <!-- DETALLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalle"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingTop="10dp" />
            <Button
                android:id="@+id/btnDescargarPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Descargar PDF"
                android:textAllCaps="false"
                android:textSize="16sp" />


        </LinearLayout>

    </ScrollView>

</LinearLayout>